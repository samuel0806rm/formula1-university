# Copia este archivo como server/.env y deposita tu clave aqui.
# server/.env NO se sube a GitHub (esta en .gitignore). Nunca pegues tu clave en otro archivo.
API_BASE_URL=https://nfc.multimediaudeb.com/api/v1
API_TOKEN=  #DEPOSITA_TU_CLAVE_AQUI
PORT=3001
# ID del usuario con permisos administrativos locales. No es un perfil de TunjaAPI.
ADMIN_USER_ID=
# Correos de las cuentas administradoras, separados por coma (sin distinguir mayúsculas).
# Ejemplo: ADMIN_EMAILS=admin1@ejemplo.com,admin2@ejemplo.com
ADMIN_EMAILS=
# Contraseña compartida del equipo para los correos de ADMIN_EMAILS (mínimo 8 caracteres).
# Con ella esas cuentas entran directo en Iniciar sesión; si no existen en la API, el servidor las crea.
CUENTAS_EQUIPO_CONTRASENA=
